# Optional: required on networks where direct WebRTC cannot connect.
# Copy to .streamlit/secrets.toml locally, or paste into Community Cloud Secrets.
# Obtain actual, preferably short-lived credentials from your TURN provider.
[turn]
urls = ["turn:your-relay.example.com:3478", "turns:your-relay.example.com:5349?transport=tcp"]
username = "REPLACE_WITH_TURN_USERNAME"
credential = "REPLACE_WITH_TURN_CREDENTIAL"
